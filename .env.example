DB_HOST=cep-mysql
DB_PORT=3306
DB_USER=cep
DB_PASSWORD=change-me
DB_NAME=cep_public

# Host bind mounts for docker-compose.yml.
AUDIO_DIR=./audio
# EMBEDDING_MODELS_DIR=/srv/models

AUDIO_FILES_PATH=/audio
AUDIO_BASE_URL=http://localhost

API_KEY=

# Admin API connection (for import).
ADMIN_API_URL=http://admin-api:8000
ADMIN_API_KEY=

# The chat/audio surface has one explicit switch. When false, do not set any
# AI_<STAGE> provider/model/endpoint/key variables or AI_CLIENT_HMAC_KEY.
AI_ENABLED=false

# Local development only. When true, /api/ai/question uses English for an
# unsupported or undetermined language. Keep false outside local debugging.
DEBUG=false

# Local/test incident diagnostic only. When true, question-provider request
# and response bodies (including prayer-derived text) are written to the
# service log. Never enable in production.
AI_QUESTION_LOG_PROVIDER_BODIES=false

# To enable AI, change the switch to true and configure all four stages.
# Providers: question/rewrite/rerank = gemini | openai_compat;
# transcription = gemini | openai_compat | local.
# Endpoints exist only for openai_compat. Provider API keys are exported from
# the invoking shell, never stored here; an explicitly empty export means no
# Authorization header only for openai_compat. Gemini keys must be non-empty.
# Every openai_compat chat stage also requires its own REASONING_EFFORT:
# omit | none | low | medium | high. `omit` explicitly leaves the request
# field out for an endpoint/model that does not support it. Gemini stages must
# not set this variable. Transcription and embeddings have no reasoning field.
# Example:
#   export AI_QUESTION_API_KEY='...'
#   export AI_SCRIPTURE_REWRITE_API_KEY=''
#   export AI_SCRIPTURE_RERANK_API_KEY='...'
#   export AI_TRANSCRIBE_API_KEY='...'
# AI_CLIENT_HMAC_KEY=generate-a-separate-random-secret
# AI_QUESTION_PROVIDER=openai_compat
# AI_QUESTION_MODEL=your-question-model
# AI_QUESTION_ENDPOINT=https://your-question-server/v1
# AI_QUESTION_REASONING_EFFORT=omit
# AI_SCRIPTURE_REWRITE_PROVIDER=openai_compat
# AI_SCRIPTURE_REWRITE_MODEL=your-rewrite-model
# AI_SCRIPTURE_REWRITE_ENDPOINT=https://your-rewrite-server/v1
# AI_SCRIPTURE_REWRITE_REASONING_EFFORT=omit
# AI_SCRIPTURE_RERANK_PROVIDER=openai_compat
# AI_SCRIPTURE_RERANK_MODEL=your-rerank-model
# AI_SCRIPTURE_RERANK_ENDPOINT=https://your-rerank-server/v1
# AI_SCRIPTURE_RERANK_REASONING_EFFORT=omit
# AI_TRANSCRIBE_PROVIDER=openai_compat
# AI_TRANSCRIBE_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# AI_TRANSCRIBE_ENDPOINT=https://your-audio-server/v1

# Local transcription replaces its endpoint/key with a weights path:
# AI_TRANSCRIBE_PROVIDER=local
# AI_TRANSCRIBE_MODEL=small
# AI_TRANSCRIBE_MODEL_PATH=/models/whisper/small

# Embeddings are independent from AI_ENABLED and always explicit. This
# example uses the remote OpenAI-compatible bge-m3 server. Export its key from
# the invoking shell before `docker compose up`; `export EMBEDDING_API_KEY=`
# explicitly selects no Authorization header.
EMBEDDING_PROVIDER=openai_compat
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_ENDPOINT=https://your-embedding-server/v1

# Local embeddings replace endpoint/key with the mounted weights path:
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_MODEL_PATH=/models/bge-m3

# Gemini embeddings have no endpoint and require a non-empty
# EMBEDDING_API_KEY from the invoking shell:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# Optional operational parameters (reviewed defaults shown).
# Speculative requests are disabled independently for questions and scripture.
# Accepted prefetch also counts against the existing total request limits.
# AI_QUESTION_PREFETCH_ENABLED=false
# AI_QUESTION_PREFETCH_REQUESTS_PER_MINUTE=2
# AI_QUESTION_PREFETCH_REQUESTS_PER_CLIENT_PER_MINUTE=1
# AI_SCRIPTURE_PREFETCH_ENABLED=false
# AI_SCRIPTURE_PREFETCH_REQUESTS_PER_MINUTE=2
# AI_SCRIPTURE_PREFETCH_REQUESTS_PER_CLIENT_PER_MINUTE=1
# AI_REQUESTS_PER_MINUTE=10
# AI_REQUESTS_PER_CLIENT_PER_MINUTE=3
# AI_QUESTION_TIMEOUT_SECONDS=20
# AI_QUESTION_MAX_TOKENS=4096
# AI_SCRIPTURE_PROVIDER_TIMEOUT_SECONDS=8
# AI_TRANSCRIBE_COMPUTE_TYPE=int8
# AI_TRANSCRIBE_THREADS=0
# AI_TRANSCRIBE_BEAM_SIZE=1
# AI_TRANSCRIBE_TIMEOUT_SECONDS=60
# AI_TRANSCRIBE_MAX_AUDIO_SECONDS=600

# Reverse proxies whose X-Forwarded-For header is trusted. Prefer names;
# empty means no proxy in front of this API.
TRUSTED_PROXY_HOSTS=
TRUSTED_PROXY_IPS=
# TRUSTED_PROXY_DNS_TTL_SECONDS=30
