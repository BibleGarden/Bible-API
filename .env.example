DB_HOST=cep-mysql
DB_PORT=3306
DB_USER=cep
DB_PASSWORD=change-me
DB_NAME=cep_public

# Host bind mounts for docker-compose.yml
# AUDIO_DIR is required (host path where mp3 files are stored)
AUDIO_DIR=./audio

MP3_FILES_PATH=/audio
AUDIO_BASE_URL=http://localhost

API_KEY=

# Admin API connection (for import)
ADMIN_API_URL=http://admin-api:8000
ADMIN_API_KEY=

# Twinkler AI and voice transcription (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=10
GEMINI_REQUESTS_PER_CLIENT_PER_MINUTE=3
TWINKLER_SYSTEM_PROMPT=
TWINKLER_CLIENT_HMAC_KEY=

# Optional: separate (paid) key for the retrieval REWRITE stage only — it is
# the one pinned to gemini-3.7-flash, whose free daily quota the traffic
# exhausts. Unset or blank: rewrites use GEMINI_API_KEY like every other
# call. Setting it while GEMINI_API_KEY is empty is a startup error.
# RETRIEVAL_REWRITE_API_KEY=

# Comma-separated direct peer IPs whose X-Forwarded-For header is trusted
TRUSTED_PROXY_IPS=
