DB_HOST=cep-mysql
DB_PORT=3306
DB_USER=cep
DB_PASSWORD=change-me
DB_NAME=cep_public

# Host bind mounts for docker-compose.yml
# AUDIO_DIR is required (host path where mp3 files are stored)
AUDIO_DIR=./audio
# Host directory holding the embedding model directories, mounted read-only
# at /models (only read when EMBEDDING_PROVIDER=local — see below).
# EMBEDDING_MODELS_DIR=/srv/models

AUDIO_FILES_PATH=/audio
AUDIO_BASE_URL=http://localhost

API_KEY=

# Admin API connection (for import)
ADMIN_API_URL=http://admin-api:8000
ADMIN_API_KEY=

# AI companion and voice transcription (server-side only). The variables are
# named after the method they configure: AI_* covers the whole AI surface,
# AI_SCRIPTURE_* only the selection pipeline.
# The system prompt of /api/ai/question is NOT an environment variable — it
# lives in app/question_prompt.py (QUESTION_PROMPT, versioned).
GEMINI_API_KEY=
AI_QUESTION_MODEL=gemini-3.7-flash
AI_TRANSCRIBE_MODEL=gemini-3.5-flash-lite
AI_REQUESTS_PER_MINUTE=10
AI_REQUESTS_PER_CLIENT_PER_MINUTE=3
AI_CLIENT_HMAC_KEY=

# Which transport serves each chat stage (ADR 0009): gemini | openai_compat.
# Required as soon as any AI is configured — an .env with only GEMINI_API_KEY
# does not start. Transcription has no provider variable: it is Gemini-only
# until it moves to a local speech model, and AI_TRANSCRIBE_PROVIDER is a
# startup error.
AI_QUESTION_PROVIDER=gemini
AI_SCRIPTURE_REWRITE_PROVIDER=gemini
AI_SCRIPTURE_RERANK_PROVIDER=gemini

# For stages on openai_compat (any OpenAI-compatible /chat/completions
# server). The endpoint must not carry credentials or a query string — the
# key goes here, where nothing logs it. An EMPTY key is an explicit
# statement: send no Authorization header.
# AI_OPENAI_COMPAT_ENDPOINT=https://your-model-server:8443/v1
# AI_OPENAI_COMPAT_API_KEY=
# Per-stage overrides of the two above, when one stage runs elsewhere or
# bills a different key:
# AI_QUESTION_ENDPOINT=
# AI_SCRIPTURE_REWRITE_ENDPOINT=
# AI_SCRIPTURE_RERANK_ENDPOINT=
# AI_QUESTION_API_KEY=
# AI_SCRIPTURE_RERANK_API_KEY=

# Optional: separate (paid) key for the retrieval REWRITE stage only — on
# Gemini it is the one pinned to gemini-3.7-flash, whose free daily quota the
# traffic exhausts. Unset or blank: rewrites use the shared key of that
# stage's provider. Setting it while the stage is on gemini and
# GEMINI_API_KEY is empty is a startup error.
# AI_SCRIPTURE_REWRITE_API_KEY=

# The vector index of the scripture selection (ADR 0002 / ADR 0010).
# EMBEDDING_MODEL + EMBEDDING_DIMENSIONS are half of the stored index
# version ("c{chunking}:{model}@{dims}"), so they are required in EVERY
# deployment, with or without any AI key: changing either one means
# `python app/index_cli.py rebuild`.
# EMBEDDING_PROVIDER says who computes the vectors and is required too:
#   local   BAAI/bge-m3 in this process, no network, ~2.5 GB RSS
#   gemini  the embedContent API, needs GEMINI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
# Where the weights are mounted IN THE CONTAINER (see EMBEDDING_MODELS_DIR
# for the host side). Required for, and only for, EMBEDDING_PROVIDER=local;
# nothing is ever downloaded — the image runs with HF_HUB_OFFLINE=1.
EMBEDDING_MODEL_PATH=/models/bge-m3
# The previous configuration, for reference:
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=768

# Per-call ceilings (operational; the defaults are the measured Gemini
# values). Raise them for a slower self-hosted model — raising
# AI_SCRIPTURE_TIMEOUT_SECONDS alone is not enough, every call is capped by
# the MINIMUM of the two.
# AI_QUESTION_TIMEOUT_SECONDS=20
# AI_SCRIPTURE_PROVIDER_TIMEOUT_SECONDS=8

# Reverse proxies whose X-Forwarded-For header is trusted. Prefer NAMES:
# container addresses do not survive a reboot, and a stale pin silently makes
# every client look like the proxy (ClickUp 86cbbq6vz). Empty everywhere =
# no proxy in front of this API (the local setup).
# TRUSTED_PROXY_HOSTS=bible-web
TRUSTED_PROXY_HOSTS=
# Literal addresses and/or CIDR networks, additive with the names above. A
# whole subnet trusts every container in it — prefer a name.
TRUSTED_PROXY_IPS=
# How stale a resolved proxy address may get, in seconds (default 30).
# TRUSTED_PROXY_DNS_TTL_SECONDS=30
