NEH 1:11 2:20 3:38 4:17 5:19 6:19 7:73 8:18 9:37 10:40 11:36 12:47 13:31
JOL 1:20 2:32 3:21
NUM 26:1 = NUM 25:19
NUM 26:1 = NUM 26:1
NEH 7:69-73 = NEH 7:68-72
JOL 2:28-32 = JOL 3:1-5
JOL 3:1-21 = JOL 4:1-21
